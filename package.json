{
  "name": "mdwiki",
  "version": "0.1.0",
  "description": "Local-first Markdown vault browsing and search through CLI and MCP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdwiki": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
