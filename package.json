{
  "name": "mdwiki",
  "version": "0.1.0",
  "description": "Local-first Markdown vault search, backlinks and safe writes through CLI and MCP",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mdwiki": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/USAGE.md",
    "docs/AGENTS.md",
    "docs/DEVELOPMENT.md",
    "docs/DEPENDENCIES.json",
    "docs/RELEASE.md",
    "docs/ACCEPTANCE.md",
    "docs/BENCHMARK.md",
    "docs/features/v0.1/SPEC.md",
    "examples/"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "mdast-util-from-markdown": "2.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "author": "ContractorKeith",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContractorKeith/mdwiki.git"
  },
  "homepage": "https://github.com/ContractorKeith/mdwiki#readme",
  "bugs": {
    "url": "https://github.com/ContractorKeith/mdwiki/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "mcp",
    "cli",
    "local-first"
  ]
}
